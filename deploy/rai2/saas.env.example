RAI2_SAAS_DATA_DIR=/var/lib/rai2/saas
RAI2_SAAS_PORT=8812
RAI2_MAX_WORKSPACES=6
RAI2_TRIAL_IDLE_MS=86400000
RAI2_SAAS_ORIGIN=https://app.rai2.si
RAI2_TENANT_DOMAIN=rai2.si
RAI2_FLEET_SOCKET=/run/openmausbot/fleet.sock
RAI2_BANK_ACCOUNT=0000000000
RAI2_BANK_NAME="Your Bank"
RAI2_SEPAY_API_KEY=replace-with-a-long-secret-from-sepay
RAI2_SEPAY_WEBHOOK_SECRET=replace-with-the-hmac-secret-shown-once-by-sepay
RAI2_OTP_PEPPER=replace-with-32-or-more-random-characters
RAI2_TENANT_SIGNING_KEY=replace-with-a-different-32-or-more-character-secret
RAI2_SIGNIN_SMTP_URL=smtps://user:percent-encoded-password@mail.example.com:465
