# Domain doanh nghiep (khong co https://)
DOMAIN=ai.doanhnghiep.vn
OMB_SERVER_NAME=RAI2 Enterprise On-Premise

# License Key ky so Ed25519 do RAI2 cap (BAT BUOC)
RAI2_LICENSE_KEY=RAI2C1.replace_with_signed_token

# Email quan tri vien duoc phep dang nhap (cach nhau boi dau phay)
OMB_SIGNIN_EMAILS=ceo@doanhnghiep.vn,it@doanhnghiep.vn

# SMTP noi bo cong ty de gui ma OTP dang nhap (tuy chon)
OMB_SIGNIN_SMTP_URL=
OMB_SIGNIN_SMTP_FROM=ai-noreply@doanhnghiep.vn

# Air-gapped Local LLM (tuy chon: chay `docker compose --profile local-llm up -d`)
# Vi du: http://ollama:11434/v1 hoac http://vllm-internal:8000/v1
LOCAL_LLM_URL=
LOCAL_LLM_API_KEY=
